{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibtnm.local/schemas/target-revision-1.1.0.json",
  "title": "IBTNM target revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "id", "parent", "driver", "target_profile", "site", "rtu", "mappings", "routes"],
  "properties": {
    "artifact_type": {"const": "ibtnm.target-revision"},
    "schema_version": {"const": "1.1.0"},
    "id": {"type": "string", "pattern": "^revision:sha256:[0-9a-f]{64}$"},
    "parent": {"type": "string"},
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "target_profile": {"type": "string", "minLength": 1},
    "site": {"type": "string", "minLength": 1},
    "rtu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "common_address", "protocol"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "common_address": {"type": "integer", "minimum": 0},
        "protocol": {"const": "iec104"}
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point_id", "iidm_id", "type", "data_class", "common_address", "ioa", "asdu", "quantity", "unit"],
        "properties": {
          "point_id": {"type": "string", "minLength": 1},
          "iidm_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["TM", "TS", "TC", "TVC"]},
          "data_class": {"enum": ["A", "B", "C"]},
          "common_address": {"type": "integer", "minimum": 0},
          "ioa": {"type": "integer", "minimum": 0},
          "asdu": {"type": "string", "minLength": 1},
          "quantity": {"type": "string"},
          "unit": {"type": "string"}
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumer", "intent", "point_ids", "provider", "service"]
      }
    },
    "target_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "render_only", "qualified_versions", "apply_order", "services"],
      "properties": {
        "format": {"const": "fledge-service-bundle"},
        "version": {"const": "1.0"},
        "render_only": {"const": true},
        "qualified_versions": {"type": "object"},
        "apply_order": {"type": "array", "items": {"type": "string"}},
        "services": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "plugin", "enabled", "config"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"enum": ["south", "north"]},
              "plugin": {"type": "string", "minLength": 1},
              "enabled": {"const": false},
              "config": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
